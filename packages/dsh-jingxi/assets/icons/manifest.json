{
  "schemaVersion": 1,
  "name": "Jingxi Icon System V1.5",
  "designVersion": "V1.5",
  "productVersion": "V1.0.1",
  "supersedes": "V1.0 asset paths remain compatible; V1.5 runtime semantics take precedence on the updated surfaces. V1.0.1 Pure Breath removes all quota/billing layers and groups.",
  "canvas": {
    "width": 128,
    "height": 128,
    "format": "png",
    "background": "transparent"
  },
  "sourcePolicy": "Crops are derived from user-provided reference boards; source boards remain outside the publish package.",
  "sources": {
    "optimizedBoard": "user-provided Jingxi Icon System V1.0 board",
    "v15Board": "user-provided Jingxi Icon System V1.5 board"
  },
  "layers": {
    "brand": {
      "purpose": "Jingxi identity and whale breath language",
      "allowedSurfaces": ["breath.title", "share.reserved"],
      "rule": "black whale with blue spout; never use as a generic action icon"
    },
    "action": {
      "purpose": "DSH runtime actions",
      "implementation": "inline-svg-currentColor",
      "source": "lib/client.js:DshActionGlyph",
      "allowedActions": ["restart", "update", "settings"],
      "rule": "no whale body, no spout, no raster Brand asset"
    },
    "state": {
      "purpose": "Breath and Runtime state visuals",
      "allowedGroups": ["breath", "status"],
      "rule": "state visuals do not become Footer action icons"
    },
    "share": {
      "purpose": "Perfect Breath highlight visuals",
      "reservedGroups": ["brand"],
      "status": "reserved",
      "rule": "not wired into the runtime surface"
    },
    "runtimeV15": {
      "purpose": "V1.5 whale-based runtime controls and lifecycle feedback",
      "allowedSurfaces": ["sidebar.entry", "panel.runtime", "restart.status", "update.status"],
      "hostComponent": "@deepseek-ai/dsh-client-ui-primitives:FishLogo",
      "rule": "whale body is paired with exactly one action-specific water/signal language"
    },
    "spoutV15": {
      "purpose": "Reusable breath intensity states",
      "allowedSurfaces": ["breath.state", "sidebar.entry"],
      "rule": "idle, light and stable spouts are semantic states, not decorative noise"
    }
  },
